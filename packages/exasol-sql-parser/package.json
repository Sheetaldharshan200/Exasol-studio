{
  "name": "@exasol-studio/exasol-sql-parser",
  "version": "0.1.0",
  "description": "Exasol SQL grammar (ANTLR) with caret code-completion — standalone, extractable",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "generate": "antlr4ng -Dlanguage=TypeScript -o src/generated -visitor -listener src/grammar/ExasolLexer.g4 src/grammar/ExasolParser.g4",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run.ts"
  },
  "dependencies": {
    "antlr4-c3": "^3.4.1",
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "antlr4ng-cli": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
