{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exasol Studio",
  "version": "26.0.1",
  "identifier": "com.exasol.studio",
  "build": {
    "beforeDevCommand": "pnpm -w -F @exasol-studio/agent-core build && pnpm dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "pnpm -w -F @exasol-studio/agent-core build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Exasol Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../packages/agent-core/dist/agent-core.cjs": "agent-core.cjs",
      "../../../packages/agent-core/dist/skills": "skills"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MEZDRTIyOTM5MUU2NDMKUldSRDVwR1RJczRQNllvRXBGZWlhbUlsaEJ1WndpaVlESW5vRGdiclZpN2oxMzdCSnlUbjZUQ2cK",
      "endpoints": [
        "https://github.com/Sheetaldharshan200/Exasol-studio/releases/latest/download/latest.json"
      ]
    }
  }
}